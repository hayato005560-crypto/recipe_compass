<h1><%= @recipe.title %></h1>

<div>
  <% @recipe.purposes.each do |purpose| %>
    <p><%= purpose.name %></p>
  <% end %>
</div>

<div>
  <% if @recipe.image.attached? %>
    <%= image_tag @recipe.image %>
  <% end %>
</div>

<div>
  <h2>材料</h2>
  <p><%= @recipe.ingredients %></p>
</div>

<div>
  <h2>調理時間</h2>
  <p><%= @recipe.cooking_time %>分</p>
</div>

<div>
  <h2>作り方</h2>
  <p><%= @recipe.steps %></p>
</div>

<div>
  <h2>補足説明</h2>
  <p><%= @recipe.body %></p>
</div>

<div>
  <% if Current.user == @recipe.user && !Current.user.is_guest? %>
    <%= button_to "編集", edit_recipe_path(@recipe), method: :get %>
    <%= button_to "削除", @recipe, method: :delete %>
  <% end %>
</div>

<div>
  <% @comments.each do |comment| %>
    <p><%= comment.user.name %></p>
    <p><%= comment.body %></p>

    <% if Current.user == comment.user %>
      <%= button_to "編集", edit_recipe_comment_path(@recipe, comment), method: :get %>
      <%= button_to "削除", recipe_comment_path(@recipe, comment), method: :delete %>
    <% end %>

  <% end %>
</div>

<div>
  <% if Current.user.present? && !Current.user.is_guest? %>
    <%= form_with url: recipe_comments_path(@recipe), scope: :comment do |form| %>
      <%= form.label :body, "コメント" %>
      <%= form.text_area :body %>
      <%= form.submit "コメントする" %>
    <% end %>
  <% end %>
</div>
