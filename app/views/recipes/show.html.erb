<div class="row justify-content-center">
  <div class="col-12 col-lg-10">

    <!-- レシピ本体 -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5">

      <div class="text-center mb-4">
        <h1 class="fw-bold mb-3"><%= @recipe.title %></h1>

        <div class="d-flex flex-wrap justify-content-center gap-2">
          <% @recipe.purposes.each do |purpose| %>
            <span class="badge rounded-pill text-bg-warning fs-5 px-3 py-2">
              <%= purpose.name %>
            </span>
          <% end %>
        </div>
      </div>

      <% if @recipe.image.attached? %>
        <div class="text-center mb-4">
            <%= image_tag @recipe.image,
                        class: "w-100 rounded-4 recipe-show-image",
                        alt: @recipe.title %>
        </div>
      <% end %>

      <!-- 材料 -->
      <div class="card border-0 bg-light rounded-4 p-4 mb-3">
        <h2 class="h4 fw-bold mb-3">材料</h2>
        <%= simple_format(@recipe.ingredients, class: "mb-0") %>
      </div>

      <!-- 調理時間 -->
      <div class="card border-0 bg-light rounded-4 p-4 mb-3">
        <h2 class="h4 fw-bold mb-3">調理時間</h2>
        <p class="mb-0"><%= @recipe.cooking_time %>分</p>
      </div>

      <!-- 作り方 -->
      <div class="card border-0 bg-light rounded-4 p-4 mb-3">
        <h2 class="h4 fw-bold mb-3">作り方</h2>
        <%= simple_format(@recipe.steps, class: "mb-0") %>
      </div>

      <!-- 補足説明 -->
      <div class="card border-0 bg-light rounded-4 p-4 mb-4">
        <h2 class="h4 fw-bold mb-3">補足説明</h2>
        <%= simple_format(@recipe.body, class: "mb-0") %>
      </div>

      <% if Current.user == @recipe.user && !Current.user.is_guest? %>
        <div class="d-flex justify-content-end gap-2">
          <%= link_to "編集",
                      edit_recipe_path(@recipe),
                      class: "btn btn-outline-warning rounded-pill px-4" %>

          <%= button_to "削除",
                        recipe_path(@recipe),
                        method: :delete,
                        class: "btn btn-outline-danger btn-sm rounded-pill px-3",
                        form_class: "d-inline",
                        form: {
                          data: {
                            turbo_confirm: "このレシピを削除しますか？"
                          }
                        } %>
        </div>
      <% end %>

    </div>


    <!-- コメント -->
    <section class="mb-5">
      <h2 class="text-center mb-4">コメント</h2>

      <% if @comments.any? %>
        <% @comments.each do |comment| %>

          <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">

            <p class="fw-bold mb-2">
              <%= comment.user.name %>
            </p>

            <p class="mb-3">
              <%= comment.body %>
            </p>

            <% if Current.user == comment.user %>
              <div class="d-flex justify-content-end gap-2">

                <%= link_to "編集",
                            edit_recipe_comment_path(@recipe, comment),
                            class: "btn btn-outline-warning btn-sm rounded-pill px-3" %>

                <%= button_to "削除",
                              recipe_comment_path(@recipe, comment),
                              method: :delete,
                              class: "btn btn-outline-danger btn-sm rounded-pill px-3",
                              form_class: "d-inline",
                                form: {
                                  data: {
                                    turbo_confirm: "このコメントを削除しますか？"
                                  }
                                } %>

              </div>
            <% end %>

          </div>

        <% end %>
      <% else %>

        <div class="card border-0 shadow-sm rounded-4 p-4 text-center mb-4">
          <p class="mb-0">まだコメントはありません。</p>
        </div>

      <% end %>
    </section>

    <% if @comment&.errors&.any? %>
      <div class="text-danger mb-3">
        <ul class="mb-0">
          <% @comment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- コメント投稿 -->
    <% if Current.user.present? && !Current.user.is_guest? %>
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-5">

        <h2 class="h4 fw-bold mb-4">コメントを投稿</h2>

        <%= form_with url: recipe_comments_path(@recipe),
                      scope: :comment do |form| %>

          <div class="mb-3">
            <%= form.label :body, "コメント", class: "form-label fw-bold" %>
            <%= form.text_area :body,
                               class: "form-control",
                               rows: 5 %>
          </div>

          <div class="text-end">
            <%= form.submit "コメントする",
                            class: "btn btn-warning rounded-pill px-4" %>
          </div>

        <% end %>

      </div>
    <% end %>

  </div>
</div>
