<div class="row justify-content-center">
  <div class="col-12 col-lg-10">

    <h1 class="text-center fw-bold mb-4">
      レシピ一覧
    </h1>

    <% if @recipes.any? %>

      <% @recipes.each do |recipe| %>

        <%= link_to admin_recipe_path(recipe),
                    class: "admin-recipe-card-link text-decoration-none text-dark" do %>

          <div class="card border-0 shadow-sm rounded-4 mb-4 admin-recipe-card overflow-hidden">

            <div class="row g-0">

              <!-- レシピ画像 -->
              <div class="col-12 col-md-4">
                <% if recipe.image.attached? %>
                  <%= image_tag recipe.image,
                                class: "admin-recipe-index-image",
                                alt: recipe.title %>
                <% else %>
                  <div class="admin-recipe-index-image-placeholder d-flex align-items-center justify-content-center">
                    <span class="text-muted">
                      No Image
                    </span>
                  </div>
                <% end %>
              </div>

              <!-- レシピ情報 -->
              <div class="col-12 col-md-8">
                <div class="card-body p-4 h-100">

                  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                    <div>
                      <h2 class="h4 fw-bold mb-3">
                        <%= recipe.title %>
                      </h2>

                      <p class="mb-2">
                        <span class="fw-bold">レシピID：</span>
                        <%= recipe.id %>
                      </p>

                      <p class="mb-2">
                        <span class="fw-bold">投稿者：</span>
                        <%= recipe.user.name %>
                      </p>

                      <p class="mb-0">
                        <span class="fw-bold">調理時間：</span>
                        <%= recipe.cooking_time %>分
                      </p>
                    </div>

                    <% if recipe.purposes.any? %>
                      <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <% recipe.purposes.each do |purpose| %>
                          <span class="badge rounded-pill text-bg-warning px-3 py-2">
                            <%= purpose.name %>
                          </span>
                        <% end %>
                      </div>
                    <% end %>

                  </div>

                </div>
              </div>

            </div>

          </div>

        <% end %>

      <% end %>

    <% else %>

      <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
        <p class="mb-0 text-muted">
          投稿されたレシピはありません。
        </p>
      </div>

    <% end %>

  </div>
</div>