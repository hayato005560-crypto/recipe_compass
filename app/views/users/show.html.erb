<h1><%= @user.name %></h1>

<h2>
  自己紹介<br>
  <%= @user.introduction %>
</h2>

<div>
  <h2>投稿レシピ一覧</h2>
  
  <% @user.recipes.each do |recipe| %>
    <%= recipe.title %>
  <% end %>
</div>

<div>
  <% if @user == Current.user %>
    <%= button_to "プロフィール編集", edit_user_path(@user), method: :get %>
    <%= button_to "退会する", @user, method: :delete %>
  <% end %>
</div>